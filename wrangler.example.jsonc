{
  "name": "lumina-stream",
  "main": ".worker-build/index.js",
  "compatibility_date": "2026-11-23",
  "assets": {"directory":"dist","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"lumina-stream-orders","database_id":"REPLACE_WITH_REAL_DATABASE_ID","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"lumina-stream-invoices-private"}],
  "vars": {"AUTH_MODE":"password"}
}
